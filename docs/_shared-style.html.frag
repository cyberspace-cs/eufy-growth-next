
:root{--ink:#142e3d;--muted:#566973;--blue:#087c9a;--mint:#dcf2ec;--line:#d9e1e1;--paper:#f5f6f2;--white:#fff;--accent:#cced6b;--nav:238px}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:100px}body{margin:0;background:var(--paper);color:var(--ink);font-family:"PingFang SC","Microsoft YaHei","Noto Sans CJK SC",sans-serif;font-size:16px;line-height:1.85;-webkit-font-smoothing:antialiased}button,a{-webkit-tap-highlight-color:transparent}a{color:var(--blue);text-decoration:none}a:hover{text-decoration:underline}button{font:inherit;cursor:pointer}p{margin:0 0 1.1em}strong{font-weight:650}h1,h2,h3,h4{font-weight:650;line-height:1.4;margin:0}h3{font-size:23px;margin:36px 0 16px;letter-spacing:-.4px}h4{font-size:18px;margin:25px 0 10px}.topbar{height:76px;position:sticky;top:0;z-index:30;background:rgba(245,246,242,.97);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 38px;gap:24px}.brand{color:var(--ink);font-family:Georgia,serif;font-size:32px;font-weight:bold;letter-spacing:-1px}.brand span{font-family:"PingFang SC",sans-serif;font-size:14px;font-weight:500;letter-spacing:1px;margin-left:7px}.top-meta{font:11px Georgia,serif;letter-spacing:2px;color:var(--muted)}.tools{display:flex;align-items:center;gap:20px;font-size:12px;white-space:nowrap}.tools button{border:1px solid var(--line);padding:8px 13px;border-radius:4px;background:transparent;color:var(--ink);font-size:12px}.sidebar{position:fixed;top:76px;bottom:0;left:0;width:var(--nav);padding:32px 18px 20px 26px;border-right:1px solid var(--line);overflow-y:auto}.sidebar-label{font-size:10px;letter-spacing:2px;color:var(--muted);margin:0 0 19px 9px}.sidebar nav{display:grid;gap:2px}.sidebar nav a{display:flex;gap:11px;padding:8px 9px;color:var(--muted);font-size:12px;line-height:1.65;border-radius:4px}.sidebar nav a span{font:11px Georgia,serif;color:#87989d;padding-top:4px}.sidebar nav a.active{background:#e5eeeb;color:var(--ink);font-weight:600}.side-note{font-size:11px;line-height:1.8;color:var(--muted);margin:30px 9px 0;padding-top:18px;border-top:1px solid var(--line)}.dot{display:inline-block;width:6px;height:6px;background:var(--blue);border-radius:100%;margin-right:6px}main{margin-left:var(--nav);max-width:1700px}.hero{background:var(--ink);color:white;padding:44px 58px 0;overflow:hidden;position:relative}.hero-top{display:flex;justify-content:space-between;gap:18px;align-items:center}.eyebrow{font-family:Georgia,serif;letter-spacing:2.1px;font-size:11px;color:var(--blue);display:block}.hero .eyebrow{color:#abd9db}.tag{display:inline-block;font-size:10px;letter-spacing:.7px;border:1px solid #ccd6d9;padding:5px 10px;border-radius:3px;line-height:1.7;white-space:nowrap}.hero .tag{border-color:#44616e;color:#bcd0d7}.hero-grid{display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:30px;padding:58px 0 46px}.hero-overline{font-size:13px;letter-spacing:2px;color:#bdcfd3;margin-bottom:19px}h1{font-size:clamp(40px,4.5vw,67px);line-height:1.22;font-family:"Songti SC","STSong",serif;letter-spacing:-2px;font-weight:500}h1 span{color:var(--accent)}.hero-copy{color:#c2d2d7;font-size:15px;margin:24px 0 26px;line-height:1.9}.hero-actions{display:flex;gap:20px;align-items:center;font-size:12px}.hero-actions a{color:#d6e6e8}.hero-actions .primary{background:var(--accent);color:var(--ink);padding:12px 18px;border-radius:3px;display:flex;gap:25px;align-items:center}.age-art{padding:32px 0 32px 28px;border-left:1px solid #3d5763}.age-label{font-size:12px;letter-spacing:3px;color:#b4cbd0}.age-number{font:100px/1.5 Georgia,serif;letter-spacing:-8px;white-space:nowrap}.age-number span{color:#547482;font-size:65px;padding:0 8px}.age-number small{font-family:"PingFang SC",sans-serif;font-size:16px;letter-spacing:0;margin-left:14px}.age-line{border-top:1px solid #62858c;display:flex;justify-content:space-between;max-width:285px}.age-line i{width:7px;height:7px;margin-top:-4px;background:var(--accent);border-radius:100%}.age-art p{font-size:10px;color:#b4cbd0;margin:18px 0 0;white-space:nowrap}.pillars{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #3d5763;padding:27px 0}.pillars>div{padding:0 20px;border-right:1px solid #3d5763;display:grid;gap:7px}.pillars>div:first-child{padding-left:0}.pillars>div:last-child{border:0}.pillars span{font:10px Georgia,serif;letter-spacing:1.5px;color:#8cb7c3}.pillars strong{font-size:19px;font-weight:500}.pillars small{font-size:11px;color:#b4cbd0}.hero-note{display:flex;gap:22px;align-items:center;background:#223f4d;margin:0 -58px;padding:17px 58px;font-size:11px;color:#bdd1d6}.hero-note strong{color:var(--accent);white-space:nowrap}.reading-note{display:flex;gap:25px;padding:22px 58px;border-bottom:1px solid var(--line);font-size:12px;background:#eaf0ec;align-items:flex-start}.reading-note b{white-space:nowrap}.reading-note p{margin:0;color:var(--muted)}.chapter{padding:62px 58px;border-bottom:1px solid var(--line);background:var(--white)}.chapter:nth-of-type(2n+1){background:#fafbf8}.chapter-head{display:flex;gap:23px;align-items:flex-start;border-bottom:1px solid var(--line);padding-bottom:25px;margin-bottom:29px}.chapter-no{font:46px/1 Georgia,serif;color:#97b3b9;letter-spacing:-2px;flex-shrink:0}.chapter h2{font-family:"Songti SC","STSong",serif;font-size:34px;font-weight:600;letter-spacing:-.7px;margin:5px 0 10px}.chapter-head p{font-size:13px;color:var(--muted);margin:0}.chapter-body{font-size:15px}.chapter-body>p:first-child{font-size:16px}.table-wrap{overflow-x:auto;margin:22px 0 30px;border:1px solid var(--line);border-radius:4px;max-width:100%}table{border-collapse:collapse;width:100%;font-size:13px;line-height:1.75;text-align:left}th{background:#e9f0ed;color:#25454f;font-size:12px;font-weight:600;padding:14px 16px;white-space:normal}td{padding:15px 16px;vertical-align:top;border-top:1px solid #e2e8e7;min-width:130px}tr:nth-child(even) td{background:rgba(235,241,237,.32)}td:first-child{font-weight:550;color:#183e4b}td p{margin:0}.ref{font-size:10px;line-height:1;color:var(--blue);background:#e8f1f1;padding:3px 4px;border-radius:3px;margin:0 2px;vertical-align:super;white-space:nowrap}blockquote{margin:22px 0;padding:25px 28px;background:#edf4f1;border-left:3px solid var(--blue);color:#34535f}blockquote p:last-child{margin:0}.fine{font-size:12px;color:var(--muted)}.source-list{margin:28px 0;display:grid;grid-template-columns:1fr 1fr;column-gap:30px}.source-row{display:flex;gap:10px;border-top:1px solid var(--line);padding:12px 0;scroll-margin-top:100px;align-items:baseline}.source-row span{font:11px Georgia,serif;color:var(--muted);min-width:26px}.source-row a{font-size:12px;line-height:1.6;overflow-wrap:anywhere}.source-row:target{background:#eef5d8}.qa{border-bottom:1px solid var(--line)}.qa summary{padding:21px 24px 21px 0;font-weight:600;font-size:16px;cursor:pointer;list-style:none;position:relative;display:flex;gap:15px}.qa summary span{font:15px/1.85 Georgia,serif;color:#739da9}.qa summary:after{content:'+';position:absolute;right:0;color:var(--blue);font-size:22px;font-weight:400}.qa[open] summary:after{content:'−'}.qa p{margin:0;padding:0 32px 23px;color:var(--muted);font-size:14px}footer{padding:55px 58px;background:var(--ink);color:#bbced6;display:grid;grid-template-columns:1fr auto;gap:22px;font-size:12px}.footer-statement{font-family:"Songti SC",serif;font-size:36px;color:var(--accent);grid-column:1/-1}footer p{margin:0}footer a{color:var(--accent);align-self:end}
.rev{display:inline-block;font-size:10px;font-weight:600;padding:2px 7px;border-radius:3px;margin-left:8px;vertical-align:middle;letter-spacing:.5px}.rev-new{background:#e8f5e9;color:#1b5e20;border:1px solid #a5d6a7}.rev-mod{background:#fff3e0;color:#e65100;border:1px solid #ffcc80}.rev-keep{background:#eceff1;color:#455a64;border:1px solid #cfd8dc}.rev-block{border-left:3px solid #ff9800;background:#fffaf5;padding:14px 18px;margin:14px 0;font-size:13px;color:#5d4037}.rev-block.new{border-left-color:#4caf50;background:#f6fbf6;color:#1b4d2e}.rev-block.keep{border-left-color:#90a4ae;background:#f7f9f9;color:#37474f}
@media(max-width:950px){:root{--nav:0px}.sidebar{display:none}.chapter{padding:45px 30px}.topbar{padding:0 25px}}
@media print{@page{size:A4;margin:16mm 14mm}body{background:white;font-size:10pt;color:#172e37;line-height:1.6}.topbar,.sidebar,.tools,.hero-actions,.reading-note{display:none!important}main{margin:0;max-width:none}.hero{padding:10mm;background:#fff!important;color:#142e3d!important;border-bottom:2px solid #142e3d}.hero h1{font-size:30pt}.chapter{padding:9mm 0;background:white!important;break-before:page;border-bottom:0}.chapter h2{font-size:22pt}table{font-size:8pt;table-layout:fixed;width:100%}th,td{padding:7px;white-space:normal;overflow-wrap:anywhere}.rev{font-size:7pt}.rev-block{break-inside:avoid}.source-list{grid-template-columns:1fr}footer{background:white;color:#294e60;border-top:1px solid #294e60}footer a{display:none}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
